#!/bin/zsh
#
# o — Obsidian vault command. One verb per action:
#
#   o i [text...]             capture a line to the Inbox      -> no editor
#   o r                       AI-triage the Inbox (Copilot)    -> suggestions
#   o n [title...]            new note, fzf-pick the folder    -> vim
#   o m [title...]            new meeting note (keyword-routed) -> Obsidian app
#   o a [file]                pull a note's "- [ ]" actions into Next (backlinked)
#   o w                       weekly review draft (done+meetings+dailies) -> stdout
#   o f                       find a note and open it          -> vim
#   o g                       live-grep the vault, open match  -> vim
#   o t [offset]              today's daily note (+/-N days)   -> Obsidian app
#   o v                       open the vault                   -> vim
#   o l <folder> [name]       symlink cwd into the vault
#   o h                       show the cheat sheet
#
# `o n` fzf-picks the folder (meetings excluded) and opens a plain note in vim.
# `o m` is the meetings path: it keyword-routes the title into
# meetings/<bucket>/<yy-mm>/ (o-routes.conf; unmatched -> meetings/other/), dates
# the filename, and opens the Obsidian app.

set -euo pipefail
setopt extendedglob

SESSION="obsidian"
SELF="${0:A}"   # script path ($0 is the function name inside a function)

vault_root() { print -r -- "${OBSIDIAN_VAULT:-$HOME/obsidian/oleenger}" }

# slugify "Some Title!" -> some-title
slugify() {
  local s="${(L)*}"
  s="${s// /-}"
  s="${s//[^a-z0-9-]/}"
  while [[ "$s" == *--* ]]; do s="${s//--/-}"; done
  s="${s#-}"; s="${s%-}"
  print -r -- "$s"
}

# emit YAML frontmatter; $1 = type, $2 = "meeting" adds participants
frontmatter() {
  local ntype="$1" extra=""
  [[ "${2:-}" == full ]] && extra="participants: []"$'\n'
  print -r -- "---
type: $ntype
date: $(date +%y-%m-%d)
${extra}tags: []
---
"
}

# open a note in the Obsidian app.
# app_open <relpath> [content] — existing file: open; missing: create w/ content
app_open() {
  local relpath="$1" content="${2:-}" vault="$(vault_root)"
  local vault_name; vault_name="$(basename "$vault")"
  local abspath="$vault/$relpath"
  mkdir -p "$vault/${relpath:h}"

  local enc
  enc() { print -rn -- "$1" | perl -MURI::Escape -ne 'print uri_escape($_, "^A-Za-z0-9._~/-")' }

  local uri
  if [[ -e "$abspath" ]]; then
    uri="obsidian://open?vault=$(enc "$vault_name")&file=$(enc "${relpath%.md}")"
  else
    uri="obsidian://new?vault=$(enc "$vault_name")&file=$(enc "${relpath%.md}")&content=$(enc "$content")"
  fi

  open "$uri"
  print -- "opened: $relpath"
}

# ensure the detached obsidian session exists, rooted at the vault
ensure_session() {
  local vault="$(vault_root)"
  tmux has-session -t "$SESSION" 2>/dev/null \
    || tmux new-session -ds "$SESSION" -c "$vault"
}

# bring the session to the foreground (switch if inside tmux, else attach)
focus_session() {
  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$SESSION"
  else
    tmux attach -t "$SESSION"
  fi
}

# open a file (or "." for the vault root) in a new window of the session.
# session_open <target> [line] — with a line, open vim on that line.
session_open() {
  local target="$1" line="${2:-}" vault="$(vault_root)"
  ensure_session
  if [[ "$target" == "." ]]; then
    if tmux list-windows -t "$SESSION" -F '#{window_name}' 2>/dev/null | grep -qx vault; then
      tmux select-window -t "$SESSION:vault"
    else
      tmux new-window -t "$SESSION" -n vault -c "$vault" "nvim ."
    fi
  else
    local lineflag=""
    [[ -n "$line" ]] && lineflag="+${line} "
    tmux new-window -t "$SESSION" -c "$vault" "nvim ${lineflag}-- ${(q)target}"
  fi
  focus_session
}

# meetings sub-routing (keyword -> bucket) via o-routes.conf; echoes reldir
route_meeting() {
  local slug="$1" ym="$(date +%y-%m)" reldir
  reldir="meetings/other/$ym"
  local routes="${O_ROUTES:-${0:A:h}/o-routes.conf}"
  if [[ -n "$slug" && -f "$routes" ]]; then
    local rline bucket keywords kw
    while IFS= read -r rline || [[ -n "$rline" ]]; do
      rline="${rline%%\#*}"
      [[ "$rline" == *:* ]] || continue
      bucket="${rline%%:*}"; bucket="${bucket//[[:space:]]/}"
      [[ -n "$bucket" ]] || continue
      keywords="${rline#*:}"
      for kw in ${(z)keywords}; do
        if [[ "$slug" == *"$kw"* ]]; then
          reldir="meetings/$bucket/$ym"
          print -r -- "$reldir"
          return
        fi
      done
    done < "$routes"
  fi
  print -r -- "$reldir"
}

usage() {
  print -u2 -- "usage: o <verb> [args]
  verbs: i r n m a w f g t v l h    (run 'o h' for the full cheat sheet)"
}

# ---- verbs ----------------------------------------------------------------

# o i [text...] — capture one line to Inbox/inbox.md (no editor).
# With no text, prompt once (used by the tmux popup: pop, type, enter, gone).
verb_inbox() {
  local vault="$(vault_root)"
  local inbox="$vault/Inbox/inbox.md"
  mkdir -p "$vault/Inbox"

  local text="$*"
  if [[ -z "$text" ]]; then
    IFS= read -r "text?inbox> " || return 0
  fi
  [[ -n "$text" ]] || return 0

  print -r -- "- [ ] $text <!-- $(date '+%Y-%m-%d %H:%M') -->" >> "$inbox"
  print -- "captured."
}

# o r — AI-triage the Inbox via the GitHub Copilot CLI (suggest-only).
# Prints Do/Link/Drop suggestions; never edits the vault. Model defaults to
# gpt-6.1-sol; override with $O_COPILOT_MODEL (a copilot CLI model name).
verb_review() {
  if ! command -v copilot >/dev/null 2>&1; then
    print -u2 "o r: GitHub Copilot CLI ('copilot') not found on PATH"; exit 1
  fi
  local vault="$(vault_root)"
  local inbox="$vault/Inbox/inbox.md"
  if [[ ! -s "$inbox" ]]; then
    print -- "inbox empty — nothing to triage."; return
  fi

  local prompt="Triage this Obsidian inbox. For each '- [ ]' line, print exactly one line:
[Do|Link|Drop] <text> — <reason or target>
Do = under 2 minutes, just do it. Link = belongs in a project/note (suggest a folder or [[note]]). Drop = noise.
Only print the list. Do not edit, move, or create any files.

Inbox:
$(cat -- "$inbox")"

  local model=(--model "${O_COPILOT_MODEL:-gpt-6.1-sol}")

  # suggest-only: deny the file-writing and shell tools so it can only answer
  copilot -p "$prompt" --deny-tool write --deny-tool shell "${model[@]}"
}

# o n <title...> — new note: fzf-pick the folder, then create + open in vim.
# Meetings are excluded here — use `o m` (they need keyword routing, not a flat
# meetings/ note). Bare `o n` prompts for the title.
verb_new() {
  local vault="$(vault_root)"

  local title="$*"
  if [[ -z "$title" ]]; then
    IFS= read -r "title?title> " || return 0   # bare `o n` -> prompt for the title
  fi
  [[ -n "$title" ]] || exit 0

  local slug; slug="$(slugify "$title")"
  [[ -n "$slug" ]] || { print -u2 "o n: title reduces to an empty slug"; exit 1; }

  local folderpath
  folderpath=$(find "$vault" -mindepth 1 -maxdepth 1 -type d ! -name '.*' ! -name meetings | sort | fzf --prompt 'folder> ') || true
  [[ -n "$folderpath" ]] || exit 0
  local folder="${folderpath:t}"

  typeset -A TYPES=(Inbox note projects project cheat-sheets reference)
  local ntype="${TYPES[$folder]:-note}"

  local file="$folderpath/$slug.md"
  [[ -e "$file" ]] || frontmatter "$ntype" > "$file"
  session_open "$file"
}

# o m <title...> — new meeting note. Keyword-routes the title into
# meetings/<bucket>/<yy-mm>/ (unmatched -> meetings/other/), dates the filename,
# and opens the Obsidian app (for pasting images). Bare `o m` prompts.
verb_meeting() {
  local title="$*"
  if [[ -z "$title" ]]; then
    IFS= read -r "title?meeting> " || return 0
  fi
  [[ -n "$title" ]] || exit 0

  local slug; slug="$(slugify "$title")"
  [[ -n "$slug" ]] || { print -u2 "o m: title reduces to an empty slug"; exit 1; }

  app_open "$(route_meeting "$slug")/${slug}-$(date +%d%m%y).md" "$(frontmatter meeting full)"
}

# o f — fuzzy-find a note (bat preview pane) and open it in vim.
# fd skips hidden dirs (.obsidian/.templates/.git) and .gitignored files by default.
verb_find() {
  local vault="$(vault_root)"
  local file
  file=$(fd -e md --type f . "$vault" | fzf --preview 'bat --color=always {}') || true
  [[ -n "$file" ]] || exit 0
  session_open "$file"
}

# o g — live-grep the vault (ripgrep + fzf) and open the match in vim
verb_grep() {
  local vault="$(vault_root)"
  local rg="rg --line-number --no-heading --color=always --smart-case -g '*.md'"
  local out
  out=$(
    cd "$vault" && FZF_DEFAULT_COMMAND="$rg ''" fzf --ansi --disabled \
      --delimiter : \
      --bind "change:reload:$rg {q} || true" \
      --preview 'bat --color=always {1} --highlight-line {2}' \
      --preview-window 'up,60%,+{2}/3'
  ) || true
  [[ -n "$out" ]] || exit 0

  local file="${out%%:*}"
  local rest="${out#*:}"
  local line="${rest%%:*}"
  session_open "$vault/$file" "$line"
}

# o t [offset] — open/create today's daily note (offset in days) in the app
verb_today() {
  local off="${1:-0}"
  [[ "$off" == <-> || "$off" == -<-> ]] || { print -u2 "o t: offset must be an integer (e.g. -1, 0, 1)"; exit 1; }

  local adj
  [[ "$off" == -* ]] && adj="$off" || adj="+$off"
  local day; day="$(date -v"${adj}d" +%Y-%m-%d)"

  local content="---
type: daily
date: $day
tags: [daily-notes]
---
"
  app_open "daily/$day.md" "$content"
}

# o v — open the vault root in vim
verb_vault() { session_open "." }

# o l <folder> [name] — symlink cwd into the vault
verb_link() {
  local vault="$(vault_root)"
  if [[ $# -lt 1 || $# -gt 2 ]]; then
    print -u2 "usage: o l <vault-folder> [link-name]"
    exit 1
  fi

  local vault_folder="$1"
  local source_dir="$(pwd -P)"
  local link_name="${2:-$(basename "$source_dir")}"

  if [[ -z "$vault_folder" || "$vault_folder" = /* || "/$vault_folder/" = *"/../"* || "/$vault_folder/" = *"/./"* || "/$vault_folder/" = *"//"* ]]; then
    print -u2 "o l: vault folder must be a safe relative path"; exit 1
  fi
  if [[ -z "$link_name" || "$link_name" = */* || "$link_name" = "." || "$link_name" = ".." ]]; then
    print -u2 "o l: link name must be a single path component"; exit 1
  fi
  if [[ "$source_dir" = "$vault" || "$source_dir" = "$vault"/* ]]; then
    print -u2 "o l: source is already inside the vault"; exit 1
  fi

  local destination="$vault/$vault_folder/$link_name"
  if [[ -e "$destination" || -L "$destination" ]]; then
    print -u2 "o l: destination already exists: $destination"; exit 1
  fi

  mkdir -p "$vault/$vault_folder"
  ln -s "$source_dir" "$destination"
  print -- "linked: $destination -> $source_dir"
}

# o h — render the whole cheat sheet (markdown) via bat, falling back to cat
verb_help() {
  local vault="$(vault_root)"
  local sheet="$vault/cheat-sheets/obsidian.md"
  if [[ ! -f "$sheet" ]]; then
    print -u2 "o h: cheat sheet not found: $sheet"; exit 1
  fi
  if command -v bat >/dev/null 2>&1; then
    bat --style=plain --language=md "$sheet"
  else
    cat -- "$sheet"
  fi
}

# o a [file] — pull "- [ ]" action lines out of a note into Todo (Next), each
# with a [[backlink]] to the note; ticks the source line [x] so the same action
# is never pulled twice. With no file, fzf-pick one.
verb_actions() {
  local vault="$(vault_root)"
  local file="${1:-}"
  if [[ -z "$file" ]]; then
    file=$(fd -e md --type f . "$vault" | fzf --preview 'bat --color=always {}') || true
    [[ -n "$file" ]] || exit 0
  fi
  [[ -f "$file" ]] || { print -u2 "o a: no such file: $file"; exit 1; }

  # vault-relative path without .md, for the backlink
  local abs="${file:A}" rel
  if [[ "$abs" == "$vault"/* ]]; then rel="${abs#$vault/}"; else rel="$file"; fi
  rel="${rel%.md}"

  local -a lines
  lines=("${(@f)$(awk '/^[ \t]*- \[ \]/ { t=$0; sub(/^[ \t]*- \[ \][ \t]*/, "", t); print t }' "$file")}")
  local todo="${SELF:h}/todo" t n=0
  for t in "${lines[@]}"; do
    [[ -n "$t" ]] || continue
    "$todo" n "$t [[${rel}]]" >/dev/null
    (( ++n ))
  done
  (( n > 0 )) || { print -- "no open actions in ${rel}."; return 0; }

  # tick the pulled lines in the source so they aren't captured again
  local tmp="${file}.tmp.$$"
  awk '/^[ \t]*- \[ \]/ { sub(/- \[ \]/, "- [x]") } { print }' "$file" > "$tmp" && mv "$tmp" "$file"

  print -- "pulled $n action(s) from ${rel} → Next."
}

# o w — weekly review: this week's done items (Archive), meetings and daily
# notes, as a markdown draft on stdout (redirect or paste into a status update).
verb_week() {
  local vault="$(vault_root)"
  local since_iso="$(date -v-7d +%Y-%m-%d)"
  local since_yy="$(date -v-7d +%y-%m-%d)"

  print -- "# Weekly review — $(date +%Y-%m-%d)"

  print -- "\n## Done"
  local archive="$vault/Archive.md"
  if [[ -f "$archive" ]]; then
    awk -v since="$since_yy" '
      /^## / { keep = ($2 >= since); next }
      keep && /^- / { print }
    ' "$archive"
  fi

  print -- "\n## Meetings"
  find "$vault/meetings" -name '*.md' -mtime -7 2>/dev/null | sort | while IFS= read -r f; do
    local rel="${f#$vault/}"; print -- "- [[${rel%.md}]]"
  done

  print -- "\n## Daily notes"
  find "$vault/daily" -name '*.md' 2>/dev/null | sort | while IFS= read -r f; do
    local base="${f:t:r}"
    [[ "$base" > "$since_iso" || "$base" == "$since_iso" ]] || continue
    local rel="${f#$vault/}"; print -- "- [[${rel%.md}]]"
  done
}

# ---- dispatch -------------------------------------------------------------

verb="${1:-}"
[[ $# -gt 0 ]] && shift || true
case "$verb" in
  i)              verb_inbox "$@" ;;
  r)              verb_review "$@" ;;
  n)              verb_new "$@" ;;
  m)              verb_meeting "$@" ;;
  a)              verb_actions "$@" ;;
  w)              verb_week "$@" ;;
  f)              verb_find "$@" ;;
  g)              verb_grep "$@" ;;
  t)              verb_today "$@" ;;
  v)              verb_vault "$@" ;;
  l)              verb_link "$@" ;;
  h|-h|--help)    verb_help ;;
  "")             usage; exit 1 ;;
  *)              print -u2 "o: unknown verb '$verb'"; usage; exit 1 ;;
esac
