#!/bin/zsh
#
# focus — manage the checklist in Focus.md
#
# Usage:
#   focus                 list current tasks
#   focus add <text...>   add a task after the last checklist item
#   focus done <n>        remove checklist line <n> (handles come from `focus`)
#   focus edit            open Focus.md in $EDITOR
#
# Only top-level "- " lines are treated as tasks; the rest of the file
# (headings, prose, indented notes, HTML comments) is preserved untouched.
#
# Override the file location with FOCUS_FILE.

set -euo pipefail

VAULT="${OBSIDIAN_VAULT:-$HOME/obsidian/oleenger}"
FOCUS_FILE="${FOCUS_FILE:-$VAULT/Focus.md}"

ensure_file() {
  [[ -f "$FOCUS_FILE" ]] && return 0
  mkdir -p "${FOCUS_FILE:h}"
  print -l -- "# Focus" "" > "$FOCUS_FILE"
}

count_tasks() {
  [[ -f "$FOCUS_FILE" ]] || { print 0; return; }
  awk '/^- / { c++ } END { print c + 0 }' "$FOCUS_FILE"
}

list() {
  [[ -f "$FOCUS_FILE" ]] || { print -- "Focus is clear."; return; }
  local out
  out=$(awk '/^- / { n++; t = $0; sub(/^- (\[[ xX]\] )?/, "", t); printf "%d) %s\n", n, t }' "$FOCUS_FILE")
  [[ -n "$out" ]] && print -r -- "$out" || print -- "Focus is clear."
}

cmd="${1:-list}"
case "$cmd" in
  list|ls|"")
    list
    ;;
  add)
    shift
    [[ $# -gt 0 ]] || { print -u2 "focus: add needs task text"; exit 1; }
    ensure_file
    new="- [ ] $*"
    tmp="${FOCUS_FILE}.tmp.$$"
    awk -v new="$new" '
      /^- / { last = NR }
      { a[NR] = $0 }
      END {
        if (NR == 0) { print new; exit }
        for (i = 1; i <= NR; i++) {
          print a[i]
          if (i == last) print new
        }
        if (!last) print new
      }
    ' "$FOCUS_FILE" > "$tmp"
    mv "$tmp" "$FOCUS_FILE"
    list
    ;;
  done|rm)
    shift
    n="${1:-}"
    [[ "$n" == <-> ]] || { print -u2 "focus: done needs a task number"; exit 1; }
    total=$(count_tasks)
    (( n >= 1 && n <= total )) || { print -u2 "focus: no task $n"; exit 1; }
    removed=$(awk -v k="$n" '/^- / { c++; if (c == k) { t = $0; sub(/^- (\[[ xX]\] )?/, "", t); print t; exit } }' "$FOCUS_FILE")
    tmp="${FOCUS_FILE}.tmp.$$"
    awk -v k="$n" '/^- / { c++; if (c == k) next } { print }' "$FOCUS_FILE" > "$tmp"
    mv "$tmp" "$FOCUS_FILE"
    print -- "done: $removed"
    print --
    list
    ;;
  edit)
    exec "${EDITOR:-vim}" "$FOCUS_FILE"
    ;;
  -h|--help|help)
    sed -n '3,14p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    print -u2 "focus: unknown command '$cmd' (try: add, done, edit)"
    exit 1
    ;;
esac
