#!/bin/zsh

set -eu

vault="$HOME/obsidian/oleenger"

if [[ $# -lt 1 || $# -gt 2 ]]; then
    echo "Usage: $(basename "$0") <vault-folder> [link-name]" >&2
    exit 1
fi

vault_folder="$1"
source_dir="$(pwd -P)"
link_name="${2:-$(basename "$source_dir")}"

if [[ -z "$vault_folder" || "$vault_folder" = /* || "/$vault_folder/" = *"/../"* || "/$vault_folder/" = *"/./"* || "/$vault_folder/" = *"//"* ]]; then
    echo "Error: vault folder must be a safe relative path" >&2
    exit 1
fi

if [[ -z "$link_name" || "$link_name" = */* || "$link_name" = "." || "$link_name" = ".." ]]; then
    echo "Error: link name must be a single path component" >&2
    exit 1
fi

if [[ "$source_dir" = "$vault" || "$source_dir" = "$vault"/* ]]; then
    echo "Error: source is already inside the vault" >&2
    exit 1
fi

destination="$vault/$vault_folder/$link_name"

if [[ -e "$destination" || -L "$destination" ]]; then
    echo "Error: destination already exists: $destination" >&2
    exit 1
fi

mkdir -p "$vault/$vault_folder"
ln -s "$source_dir" "$destination"

echo "Linked: $destination -> $source_dir"
