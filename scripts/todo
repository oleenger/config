#!/bin/zsh
#
# todo — task horizons + inbox triage + archive
#
# Horizons flow one way, toward Now:
#   Now     -> Focus.md            doing it, ASAP
#   Next    -> Todo.md ## Next     do soon
#   Waiting -> Todo.md ## Waiting  blocked / delegated
#   Later   -> Todo.md ## Later    someday
#
# Usage:
#   todo                     list Now/Next/Waiting/Later, numbered
#   todo <text...>           add to Next (the common case)
#   todo f <text...>         add to Now
#   todo w <text...>         add to Waiting
#   todo l <text...>         add to Later
#   todo in                  list the Inbox, numbered
#   todo in <n> [f|n|w|l|drop]  triage inbox line n (default Next; drop = delete)
#   todo up <n>              promote toward Now (Later|Waiting -> Next, Next -> Now)
#   todo done <n>            mark done: ticks [x] (run `todo tidy` to file it away)
#   todo tidy                move every [x] item (Focus + Todo) into Archive.md
#   todo rm <n>              delete task n outright (no archive)
#   todo edit                open Todo.md in $EDITOR
#
# Only top-level "- " lines are tasks; a "[x]" line is done-but-not-yet-archived
# and no longer counts toward the numbering. Overwrite Focus.md freely.
# Override locations: FOCUS_FILE / TODO_FILE / INBOX_FILE / ARCHIVE_FILE.

set -euo pipefail

ME="${0:A}"   # script path ($0 becomes the function name inside a function)
VAULT="${OBSIDIAN_VAULT:-$HOME/obsidian/oleenger}"
TODO_FILE="${TODO_FILE:-$VAULT/Todo.md}"
FOCUS_FILE="${FOCUS_FILE:-$VAULT/Focus.md}"
INBOX_FILE="${INBOX_FILE:-$VAULT/Inbox/inbox.md}"
ARCHIVE_FILE="${ARCHIVE_FILE:-$VAULT/Archive.md}"

cleanup() {
  rm -f "$TODO_FILE".tmp.$$ "$FOCUS_FILE".tmp.$$ \
        "$INBOX_FILE".tmp.$$ "$ARCHIVE_FILE".tmp.$$ 2>/dev/null || true
}
trap cleanup EXIT INT TERM

# a live task is a top-level "- " line that is NOT ticked "[x]"
count_file() { [[ -f "$1" ]] && awk '/^- / && !/^- \[[xX]\]/ { c++ } END { print c + 0 }' "$1" || print 0; }
now_count()   { count_file "$FOCUS_FILE"; }
todo_count()  { count_file "$TODO_FILE"; }
inbox_count() { count_file "$INBOX_FILE"; }

ensure_todo() {
  [[ -f "$TODO_FILE" ]] && return 0
  mkdir -p "${TODO_FILE:h}"
  print -l -- "# Todo" "" "## Next" "" "## Waiting" "" "## Later" "" > "$TODO_FILE"
}
ensure_focus() {
  [[ -f "$FOCUS_FILE" ]] && return 0
  mkdir -p "${FOCUS_FILE:h}"
  print -l -- "# Focus" "" > "$FOCUS_FILE"
}

list() {
  local now out1="" out2=""
  now=$(now_count)
  [[ -f "$FOCUS_FILE" ]] && out1=$(awk '
    /^- / && !/^- \[[xX]\]/ { n++; t = $0; sub(/^- (\[[ xX]\] )?/, "", t); printf "%2d) [Now] %s\n", n, t }
  ' "$FOCUS_FILE")
  [[ -f "$TODO_FILE" ]] && out2=$(awk -v off="$now" '
    /^##[ \t]+/ { s = $0; sub(/^##[ \t]+/, "", s); sub(/[ \t]+$/, "", s); next }
    /^- / && !/^- \[[xX]\]/ { n++; t = $0; sub(/^- (\[[ xX]\] )?/, "", t); printf "%2d) [%s] %s\n", n + off, s, t }
  ' "$TODO_FILE")
  local all="${out1}"
  [[ -n "$out1" && -n "$out2" ]] && all+=$'\n'
  all+="$out2"
  [[ -n "$all" ]] && print -r -- "$all" || print -- "Nothing on the list."
}

# list Inbox lines, numbered; strips the "<!-- date -->" capture comment
list_inbox() {
  local out=""
  [[ -f "$INBOX_FILE" ]] && out=$(awk '
    /^- / && !/^- \[[xX]\]/ {
      n++; t = $0; sub(/^- (\[[ xX]\] )?/, "", t)
      sub(/[ \t]*<!--.*-->[ \t]*$/, "", t); sub(/[ \t]+$/, "", t)
      printf "%2d) %s\n", n, t
    }
  ' "$INBOX_FILE")
  [[ -n "$out" ]] && print -r -- "$out" || print -- "Inbox empty."
}

# append "- [ ] text" after the last task line of <file>
append_task() {
  local file="$1"; shift
  local new="- [ ] $*" tmp="${file}.tmp.$$"
  awk -v new="$new" '
    /^- / { last = NR } { a[NR] = $0 }
    END {
      if (NR == 0) { print new; exit }
      for (i = 1; i <= NR; i++) { print a[i]; if (i == last) print new }
      if (!last) print new
    }
  ' "$file" > "$tmp"
  mv "$tmp" "$file"
}

# add "- [ ] text" as the last item of <Section> in Todo.md (create if missing)
add_to() {
  local section="$1"; shift
  local new="- [ ] $*" tmp="${TODO_FILE}.tmp.$$"
  ensure_todo
  awk -v S="$section" -v new="$new" '
    { a[NR] = $0 }
    /^##[ \t]+/ {
      name = $0; sub(/^##[ \t]+/, "", name); sub(/[ \t]+$/, "", name)
      if (tolower(name) == tolower(S)) { inS = 1; last = NR } else { inS = 0 }
      next
    }
    inS && /^- / { last = NR }
    END {
      if (last == 0) {
        for (i = 1; i <= NR; i++) print a[i]
        if (NR > 0 && a[NR] != "") print ""
        print "## " S
        print new
      } else {
        for (i = 1; i <= NR; i++) { print a[i]; if (i == last) print new }
      }
    }
  ' "$TODO_FILE" > "$tmp"
  mv "$tmp" "$TODO_FILE"
}

# echo "Section<TAB>text" for the nth live task in Todo.md
todo_nth_info() {
  awk -v k="$1" '
    /^##[ \t]+/ { s = $0; sub(/^##[ \t]+/, "", s); sub(/[ \t]+$/, "", s); next }
    /^- / && !/^- \[[xX]\]/ { c++; if (c == k) { t = $0; sub(/^- (\[[ xX]\] )?/, "", t); print s "\t" t; exit } }
  ' "$TODO_FILE"
}

# echo the text of the nth live task in <file> (strips marker + capture comment)
nth_text() {
  awk -v k="$2" '
    /^- / && !/^- \[[xX]\]/ {
      c++
      if (c == k) {
        t = $0; sub(/^- (\[[ xX]\] )?/, "", t)
        sub(/[ \t]*<!--.*-->[ \t]*$/, "", t); sub(/[ \t]+$/, "", t)
        print t; exit
      }
    }
  ' "$1"
}

# delete the nth live task line in <file>
remove_nth() {
  local file="$1" tmp="${1}.tmp.$$"
  awk -v k="$2" '/^- / && !/^- \[[xX]\]/ { c++; if (c == k) next } { print }' "$file" > "$tmp"
  mv "$tmp" "$file"
}

# tick the nth live task line in <file> as "- [x] ..."
tick_nth() {
  local file="$1" tmp="${1}.tmp.$$"
  awk -v k="$2" '
    /^- / && !/^- \[[xX]\]/ {
      c++
      if (c == k) { rest = $0; sub(/^- (\[ \] )?/, "", rest); print "- [x] " rest; next }
    }
    { print }
  ' "$file" > "$tmp"
  mv "$tmp" "$file"
}

# move every "[x]" line from Focus.md + Todo.md into Archive.md under today's date
tidy() {
  local f got checked="" tmp
  for f in "$FOCUS_FILE" "$TODO_FILE"; do
    [[ -f "$f" ]] || continue
    got=$(awk '/^- \[[xX]\]/ { print }' "$f")
    [[ -n "$got" ]] && checked+="${got}"$'\n'
  done
  checked="${checked%$'\n'}"
  if [[ -z "$checked" ]]; then print -- "Nothing to tidy."; return 0; fi

  [[ -f "$ARCHIVE_FILE" ]] || { mkdir -p "${ARCHIVE_FILE:h}"; print -l -- "# Archive" "" > "$ARCHIVE_FILE"; }
  { print -- "## $(date +%y-%m-%d)"; print -r -- "$checked"; print -- ""; } >> "$ARCHIVE_FILE"

  for f in "$FOCUS_FILE" "$TODO_FILE"; do
    [[ -f "$f" ]] || continue
    tmp="${f}.tmp.$$"
    awk '!/^- \[[xX]\]/ { print }' "$f" > "$tmp"; mv "$tmp" "$f"
  done

  local n; n=$(print -r -- "$checked" | grep -c '^-')
  print -- "Archived $n item(s) → ${ARCHIVE_FILE:t}"
}

require_num() {
  [[ "$1" == <-> ]] || { print -u2 "todo: '$2' needs a task number"; exit 1; }
  local total=$(( $(now_count) + $(todo_count) ))
  (( $1 >= 1 && $1 <= total )) || { print -u2 "todo: no task $1"; exit 1; }
}

show_help() { sed -n '3,26p' "$ME" | sed 's/^# \{0,1\}//'; }

cmd="${1:-list}"
case "$cmd" in
  list|ls|"")
    list
    ;;
  f)
    shift; [[ $# -gt 0 ]] || { print -u2 "todo: f needs task text"; exit 1; }
    ensure_focus; append_task "$FOCUS_FILE" "$@"; list
    ;;
  n)
    shift; [[ $# -gt 0 ]] || { print -u2 "todo: n needs task text"; exit 1; }
    add_to Next "$@"; list
    ;;
  w)
    shift; [[ $# -gt 0 ]] || { print -u2 "todo: w needs task text"; exit 1; }
    add_to Waiting "$@"; list
    ;;
  l)
    shift; [[ $# -gt 0 ]] || { print -u2 "todo: l needs task text"; exit 1; }
    add_to Later "$@"; list
    ;;
  in)
    shift
    if [[ $# -eq 0 ]]; then list_inbox; exit 0; fi
    n="$1"; shift
    [[ "$n" == <-> ]] || { print -u2 "todo: 'in' needs an inbox line number"; exit 1; }
    ic=$(inbox_count)
    (( n >= 1 && n <= ic )) || { print -u2 "todo: no inbox line $n"; exit 1; }
    dest="${1:-n}"
    case "$dest" in
      f|n|w|l|drop) ;;
      *) print -u2 "todo: unknown destination '$dest' (use f|n|w|l|drop)"; exit 1 ;;
    esac
    text=$(nth_text "$INBOX_FILE" "$n")
    remove_nth "$INBOX_FILE" "$n"
    case "$dest" in
      drop) print -- "dropped: $text" ;;
      f)    ensure_focus; append_task "$FOCUS_FILE" "$text"; print -- "→ Now: $text" ;;
      n)    add_to Next "$text";    print -- "→ Next: $text" ;;
      w)    add_to Waiting "$text"; print -- "→ Waiting: $text" ;;
      l)    add_to Later "$text";   print -- "→ Later: $text" ;;
    esac
    print --; list
    ;;
  up)
    shift; n="${1:-}"; require_num "$n" up
    now=$(now_count)
    if (( n <= now )); then
      print -- "already at Now."
    else
      tn=$(( n - now ))
      info=$(todo_nth_info "$tn"); section="${info%%$'\t'*}"; text="${info#*$'\t'}"
      remove_nth "$TODO_FILE" "$tn"
      if [[ "${(L)section}" == next ]]; then
        ensure_focus; append_task "$FOCUS_FILE" "$text"; print -- "promoted to Now: $text"
      else
        add_to Next "$text"; print -- "promoted to Next: $text"
      fi
    fi
    print --; list
    ;;
  done)
    shift; n="${1:-}"; require_num "$n" done
    now=$(now_count)
    if (( n <= now )); then
      text=$(nth_text "$FOCUS_FILE" "$n"); tick_nth "$FOCUS_FILE" "$n"
    else
      tn=$(( n - now )); text=$(nth_text "$TODO_FILE" "$tn"); tick_nth "$TODO_FILE" "$tn"
    fi
    print -- "done: $text  (run 'todo tidy' to file it away)"; print --; list
    ;;
  rm)
    shift; n="${1:-}"; require_num "$n" rm
    now=$(now_count)
    if (( n <= now )); then
      removed=$(nth_text "$FOCUS_FILE" "$n"); remove_nth "$FOCUS_FILE" "$n"
    else
      tn=$(( n - now )); removed=$(nth_text "$TODO_FILE" "$tn"); remove_nth "$TODO_FILE" "$tn"
    fi
    print -- "removed: $removed"; print --; list
    ;;
  tidy)
    tidy
    ;;
  edit)
    exec "${EDITOR:-nvim}" "$TODO_FILE"
    ;;
  -h|--help|help)
    show_help
    ;;
  *)
    [[ "$cmd" == -* ]] && { print -u2 "todo: unknown option '$cmd' (see 'todo help')"; exit 1; }
    add_to Next "$@"; list
    ;;
esac
